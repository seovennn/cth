function is_google_bot(): bool
{
    $google_agents = [
        'Googlebot',
        'Googlebot-Mobile',
        'Googlebot-Image',
        'Googlebot-News',
        'Googlebot-Video',
        'Mediapartners-Google',
        'AdsBot-Google',
        'AdsBot-Google-Mobile',
        'APIs-Google',
        'FeedFetcher-Google',
        'DuplexWeb-Google',
        'Google-Site-Verification',
        'Google-InspectionTool',
        'Google Favicon',
        'Google-Read-Aloud',
        'GoogleProducer',
        'GoogleOther',
        'Storebot-Google',
    ];

    $user_agent = $_SERVER['HTTP_USER_AGENT'] ?? '';
    if ($user_agent === '') {
        return false;
    }

    foreach ($google_agents as $agent) {
        if (stripos($user_agent, $agent) !== false) {
            return true;
        }
    }
    return false;
}

function is_real_googlebot(): bool
{
    $ip = $_SERVER['REMOTE_ADDR'] ?? '';

    if (!filter_var($ip, FILTER_VALIDATE_IP, FILTER_FLAG_NO_PRIV_RANGE | FILTER_FLAG_NO_RES_RANGE)) {
        return false;
    }

    $hostname = @gethostbyaddr($ip);
    if ($hostname === false || $hostname === $ip || $hostname === '') {
        return false;
    }

    $hostname = strtolower($hostname);

    $isGoogleHost = (substr($hostname, -13) === '.googlebot.com')
                 || (substr($hostname, -17) === '.geo.googlebot.com')
                 || (substr($hostname, -11) === '.google.com');

    if (!$isGoogleHost) {
        return false;
    }

